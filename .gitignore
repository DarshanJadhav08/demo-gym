# ==========================================
# Git Ignore Configuration for Demo Gym App
# ==========================================

# Dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Artifacts
dist/
client/dist/
build/
.output/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env

# Local SQLite Database Files (keep schema & seed, ignore runtime binary data)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
server/database/*.db
server/database/*.db-shm
server/database/*.db-wal

# Logs & Temporary files
logs/
*.log
*.tmp
*.temp
.system_generated/
task-*.log

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Test Coverage
coverage/
.nyc_output/
